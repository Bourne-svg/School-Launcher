{
  "manifest_version": 3,
  "name": "申请书架 · 院校自动填入",
  "version": "0.0.2",
  "description": "连接本机院校登录助手，在指定申请网站填入登录资料，由你确认登录。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "https://apps.ntu.edu.sg/*",
    "https://dl.reg.163.com/*",
    "https://gpu-center.diantoueducredit.cloud/*",
    "https://mail.163.com/*",
    "https://tpgadmission.engg.hku.hk/*",
    "https://w5.ab.ust.hk/*",
    "https://www.gradsch.cuhk.edu.hk/*",
    "https://www38.polyu.edu.hk/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://apps.ntu.edu.sg/*",
        "https://dl.reg.163.com/*",
        "https://gpu-center.diantoueducredit.cloud/*",
        "https://mail.163.com/*",
        "https://tpgadmission.engg.hku.hk/*",
        "https://w5.ab.ust.hk/*",
        "https://www.gradsch.cuhk.edu.hk/*",
        "https://www38.polyu.edu.hk/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
